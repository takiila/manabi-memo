# Firebase Authentication（未設定でも端末内保存は利用できます）
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# 空欄は全認証ユーザーを許可。本番では利用する2〜3人をカンマ区切りで必ず指定
ALLOWED_ACCOUNT_EMAILS=

# 端末間同期。未設定時は .data/manabi-memo.sqlite を自動作成します
# Vercel等では postgresql://... を設定してください
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=1

# Vercel Blobを使う場合のPDF同期。Private Blob Storeだけを使用してください
BLOB_READ_WRITE_TOKEN=
# OIDCを使う場合だけ。通常はVercelが自動設定します
BLOB_STORE_ID=

# 2〜3人運営ではCloudflare R2を推奨。ブラウザから署名URLで直接転送します
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com / S3_REGION=auto
# Vercel Blobの変数と同時設定した場合はVercel Blobが優先されます
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
LOCAL_FILE_STORE=.data/objects

# 認証済みの2〜3人全員にCampus/CMTRを開く。inviteにすると招待コード制です
CAMPUS_ACCESS_MODE=authenticated
# inviteモード時だけ使用
CAMPUS_BETA_CODE=
FEEDBACK_ADMIN_EMAIL=

# 旧ChatGPTアカウント移行時だけ、信頼できるプロキシ下で有効化
TRUST_CHATGPT_AUTH_HEADERS=false
