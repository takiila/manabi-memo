# Firebase Authentication（未設定でも端末内保存は利用できます）
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# 端末間同期。未設定時は .data/manabi-memo.sqlite を自動作成します
# Vercel等では postgresql://... を設定してください
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=5

# PDF同期。S3未設定時はローカルの .data/objects を使用します
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
LOCAL_FILE_STORE=.data/objects

# 任意機能
CAMPUS_BETA_CODE=
FEEDBACK_ADMIN_EMAIL=

# 旧ChatGPTアカウント移行時だけ、信頼できるプロキシ下で有効化
TRUST_CHATGPT_AUTH_HEADERS=false
