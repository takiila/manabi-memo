          ]
        },
        "course_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "submission_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    },
    "announcement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    },
    "seminar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "academic_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2000,
          "maximum": 2200
        },
        "guidance_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "application_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "application_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "result_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "laboratory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teacher_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "research_fields": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "selection_method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "guidance_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "affiliation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "research_fields": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "maxLength": 300
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    },
