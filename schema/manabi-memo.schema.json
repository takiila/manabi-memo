          "maximum": 30
        },
        "weekday": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "period": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "room": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "syllabus_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
