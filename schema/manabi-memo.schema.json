{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takiila.github.io/manabi-memo/schema/manabi-memo.schema.json",
  "title": "Manabi Import Schema v1",
  "description": "Portable university information. Validate and review before importing. This is not an internal backup or an MCP protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "collection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pdf",
            "email",
            "web",
            "screenshot",
            "message",
            "syllabus",
            "memo",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "source",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "enum": [
            "event",
            "deadline",
            "assignment",
            "announcement",
            "seminar",
            "laboratory",
            "teacher",
            "course",
            "exam",
            "registration",
            "document"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "term": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "related_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "needs_review": {
          "type": "boolean"
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        },
        "extensions": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^x-[a-z0-9][a-z0-9-]{0,60}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 10000
          }
        },
        "data": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/event"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "deadline"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/deadline"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assignment"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/assignment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "announcement"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/announcement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "seminar"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/seminar"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "laboratory"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/laboratory"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "teacher"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/teacher"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "course"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/course"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "exam"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/exam"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "registration"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/registration"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "document"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/document"
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starts_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ends_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "due_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "submission_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "due_at": {
          "anyOf": [
            {
              "type": "string",
